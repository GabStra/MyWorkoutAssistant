material {
    name : "Wear skeleton shaded",
    shadingModel : unlit,
    doubleSided : false,
    parameters : [
        { type : float3, name : keyLightDirection },
        { type : float, name : visibility },
        { type : float3, name : backgroundColor },
        { type : float, name : ambientLight },
        { type : float, name : keyLightStrength },
        { type : float, name : fillLightStrength },
        { type : float, name : hemisphereLightStrength }
    ],
    requires : [
        color,
        custom0
    ],
    variables : [
        worldNormal
    ]
}

vertex {
    void materialVertex(inout MaterialVertexInputs material) {
        material.worldNormal = getCustom0();
    }
}

fragment {
    void material(inout MaterialInputs material) {
        prepareMaterial(material);
        vec3 normal = normalize(variable_worldNormal.xyz);
        vec3 keyLight = normalize(materialParams.keyLightDirection);
        vec3 fillLight = normalize(vec3(-keyLight.x, abs(keyLight.y) * 0.35, -keyLight.z));
        float keyDiffuse = clamp(dot(normal, keyLight), 0.0, 1.0);
        float fillDiffuse = clamp(dot(normal, fillLight), 0.0, 1.0);
        float upperHemisphere = clamp(normal.y * 0.5 + 0.5, 0.0, 1.0);
        float lightLevel = clamp(
            materialParams.ambientLight +
                keyDiffuse * materialParams.keyLightStrength +
                fillDiffuse * materialParams.fillLightStrength +
                upperHemisphere * materialParams.hemisphereLightStrength,
            0.0,
            1.0
        );
        vec3 lit = getColor().rgb * lightLevel;
        vec3 visible = mix(materialParams.backgroundColor, lit, materialParams.visibility);
        material.baseColor = vec4(visible, getColor().a);
    }
}
