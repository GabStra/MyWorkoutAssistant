<string name="wear_tutorial_heart_rate_desc">Tap the number on the left to switch between views like BPM and zone.</string>
<string name="wear_tutorial_workout_progress_title">Workout progress</string>
<string name="wear_tutorial_workout_progress_desc">The right side shows where you are in the workout so you can check the current exercise and set at a glance.</string>
<string name="wear_tutorial_complete_set_title">Finish the set</string>
<string name="wear_tutorial_complete_set_hint">Swipe to the buttons page and tap Complete Set. You can also press Back once and hold the checkmark.</string>
<string name="wear_tutorial_edit_set_title">Edit the set</string>
<string name="wear_tutorial_edit_set_desc">Long press reps, weight, or time to edit that value, then use + and - to adjust it.</string>
