<string name="wear_tutorial_rest_timer_title">Rest timer</string>
<string name="wear_tutorial_rest_timer_desc">Rest starts automatically. Long press the timer, then use + and - to adjust it.</string>
<string name="wear_tutorial_preview_exercises_title">Preview exercises</string>
<string name="wear_tutorial_preview_exercises_desc">Tap the left or right side to check the previous or next exercise without leaving rest.</string>
<string name="wear_tutorial_wake_up_title">Wake-up cue</string>
<string name="wear_tutorial_wake_up_desc">The watch turns the screen on when 5 seconds remain so you do not miss the next set.</string>
