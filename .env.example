# Copy this file to .env and fill in your values.
#
# All Python LLM scripts (workout generator, importer, exercise library tools)
# talk to any OpenAI-compatible endpoint. Unset variables fall back to OpenCode Go
# (https://opencode.ai/zen/go/v1), the provider ZCode itself uses.
#
# Endpoint and model (example: a local llama.cpp server):
#   LLM_BASE_URL=http://127.0.0.1:8080
#   LLM_MODEL=your-local-model
# LLM_BASE_URL=
# LLM_MODEL=
#
# API key, resolved as LLM_API_KEY, then OPENCODE_API_KEY, then DEEPSEEK_API_KEY,
# then OPENAI_API_KEY. Local endpoints that need no auth run with no key set.
LLM_API_KEY=
# Alternative name, still accepted when LLM_API_KEY is unset:
OPENCODE_API_KEY=your_opencode_api_key_here
# Legacy DeepSeek name, still accepted last:
DEEPSEEK_API_KEY=
